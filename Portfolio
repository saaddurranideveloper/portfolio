<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alexa Hugeh | Sustainable Knitwear & Design</title>
    <!-- Icons for social & menu -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        /* === RESET & GLOBAL === */
        :root {
            --primary-color: #8b263e; /* Maroon palette */
            --secondary-color: #2c3e50; 
            --light-bg: #fdfdfd;
            --text-dark: #222;
            --text-light: #666;
            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --header-height: 80px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--light-bg);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3 { color: var(--secondary-color); margin-bottom: 15px; font-weight: 700; }
        p { color: var(--text-light); margin-bottom: 20px; font-size: 1rem; }
        a { text-decoration: none; transition: var(--transition); color: inherit; }
        ul { list-style: none; }

        /* === REUSABLE COMPONENTS === */
        .section-padding { padding: 100px 8%; }
        
        .btn {
            display: inline-block;
            padding: 12px 35px;
            background-color: var(--primary-color);
            color: #fff;
            text-transform: uppercase;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            border: 2px solid var(--primary-color);
            cursor: pointer;
            transition: var(--transition);
        }

        .btn:hover {
            background-color: transparent;
            color: var(--primary-color);
            transform: translateY(-3px);
        }

        .section-header {
            text-align: center;
            margin-bottom: 70px;
        }

        .section-header h2 {
            font-size: 3rem;
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
            color: var(--text-dark);
        }

        .section-header h2::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background-color: var(--primary-color);
        }

        /* === SCROLL ANIMATION CLASSES === */
        .reveal {
            position: relative;
            opacity: 0;
            transition: 0.8s all ease;
        }
        .reveal.fade-bottom { transform: translateY(50px); }
        .reveal.fade-left { transform: translateX(-50px); }
        .reveal.fade-right { transform: translateX(50px); }
        
        .reveal.active {
            transform: translate(0, 0);
            opacity: 1;
        }

        /* === 1. ULTRA-RESPONSIVE HEADER === */
        header {
            height: var(--header-height);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 8%;
            background-color: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 1000;
            box-shadow: 0 2px 20px rgba(0,0,0,0.04);
            transition: var(--transition);
        }

        .logo {
            font-weight: 700;
            font-size: 24px;
            letter-spacing: 1.5px;
            color: var(--text-dark);
            text-transform: uppercase;
        }

        .nav-links {
            display: flex;
            align-items: center;
        }

        .nav-links li { margin-left: 30px; }

        .nav-links a {
            font-weight: 600;
            font-size: 13px;
            color: var(--text-dark);
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            padding-bottom: 5px;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 2px;
            background-color: var(--primary-color);
            transition: var(--transition);
        }

        .nav-links a:hover::after { width: 100%; }
        .nav-links a:hover { color: var(--primary-color); }

        .menu-toggle {
            display: none;
            font-size: 24px;
            color: var(--text-dark);
            cursor: pointer;
            z-index: 1001;
            transition: var(--transition);
        }

        /* === 2. HERO SECTION === */
        .hero {
            height: 100vh;
            /* Updated to a premium, fast-loading fashion textures background */
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                        url('https://images.pexels.com/photos/5705490/pexels-photo-5705490.jpeg?auto=compress&cs=tinysrgb&w=1600') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #fff;
            padding-top: var(--header-height);
        }

        .hero-content {
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1s forwards 0.5s;
        }

        .hero-content h1 {
            font-size: 5rem;
            margin-bottom: 20px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #fff;
        }

        .hero-content p {
            font-size: 1.5rem;
            margin-bottom: 40px;
            font-weight: 300;
            color: rgba(255,255,255,0.9);
        }

        /* === 3. ABOUT OWNER === */
        .about { background-color: #fff; }
        .about-container { display: flex; align-items: center; gap: 70px; }
        
        .about-image { 
            flex: 1; 
            text-align: center;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
            background-color: #fff;
        }
        
        .about-image img {
            width: 100%;
            height: auto;
            max-height: 550px;
            display: block;
            object-fit: contain; 
            transition: var(--transition);
        }
        .about-image:hover img {
            transform: scale(1.03);
        }

        .about-text { flex: 1.5; }
        .about-text h3 { font-size: 2rem; }
        .about-text p { font-size: 1.1rem; line-height: 1.9; }

        /* === 4. MISSION & DESIGN PHILOSOPHY === */
        .mission { background-color: var(--light-bg); text-align: center; }
        .mission-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
        }
        .mission-item {
            background-color: #fff;
            padding: 50px 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            transition: var(--transition);
        }
        .mission-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .mission-item i {
            font-size: 40px;
            color: var(--primary-color);
            margin-bottom: 25px;
        }

        /* === 5. SKILLS & EXPERTISE === */
        .skills { background-color: #fff; }
        .skills-container { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
        .skill-badge {
            background-color: var(--light-bg);
            padding: 10px 25px;
            border-radius: 30px;
            font-weight: 600;
            color: var(--secondary-color);
            box-shadow: 0 3px 6px rgba(0,0,0,0.03);
            transition: var(--transition);
        }
        .skill-badge:hover {
            background-color: var(--primary-color);
            color: #fff;
            transform: scale(1.05);
        }

        /* === 6. PORTFOLIO SHOWCASE (10 IMAGES GRID) === */
        .portfolio { background-color: var(--light-bg); }
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }
        .portfolio-card {
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: var(--transition);
            position: relative;
            background: #fff;
        }
        .portfolio-card img { width: 100%; height: 380px; object-fit: cover; display: block; transition: var(--transition); }
        .portfolio-card:hover img { transform: scale(1.06); }
        
        .portfolio-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(139, 38, 62, 0.92);
            color: #fff;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            opacity: 0;
            transition: var(--transition);
            padding: 25px;
            z-index: 2;
            text-align: center;
        }
        .portfolio-card:hover .portfolio-overlay { opacity: 1; }
        .portfolio-overlay h3 { color: #fff; margin-bottom: 8px; font-size: 1.3rem; }
        .portfolio-overlay p { color: #eee; font-size: 0.9rem; }

        /* === 7. CLIENT TESTIMONIALS === */
        .testimonials { background-color: #fff; text-align: center; }
        .testimonial-slider { display: flex; gap: 30px; overflow-x: auto; padding: 20px 0; scrollbar-width: thin; }
        .testimonial-item {
            flex: 0 0 320px;
            background-color: var(--light-bg);
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
        }
        .testimonial-item p { font-style: italic; color: var(--text-dark); }
        .testimonial-author { font-weight: 700; color: var(--secondary-color); margin-top: 15px; }

        /* === 8. CONTACT & INQUIRY === */
        .contact { background-color: var(--primary-color); color: #fff; }
        .contact .section-header h2 { color: #fff; }
        .contact .section-header h2::after { background-color: #fff; }
        .contact-form { max-width: 700px; margin: 0 auto; text-align: center; }
        .contact-form p { color: #f5f5f5; }
        .contact-form input, .contact-form textarea {
            width: 100%;
            padding: 18px;
            margin-bottom: 25px;
            border: 1px solid transparent;
            border-radius: 4px;
            font-size: 1rem;
            outline: none;
            transition: var(--transition);
        }
        .contact-form input:focus, .contact-form textarea:focus {
            border-color: var(--secondary-color);
        }
        .contact-form .btn-light {
            background-color: #fff; color: var(--primary-color); border: 2px solid #fff;
        }
        .contact-form .btn-light:hover { background-color: transparent; color: #fff; }

        /* === FOOTER === */
        footer {
            background-color: #111;
            color: #ccc;
            text-align: center;
            padding: 50px 0;
        }
        .socials { margin-bottom: 20px; }
        .socials a {
            color: #fff;
            font-size: 22px;
            margin: 0 15px;
            transition: var(--transition);
        }
        .socials a:hover { color: var(--primary-color); transform: scale(1.1); }

        /* === ANIMATIONS === */
        @keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }

        /* === RESPONSIVE CODES FOR ALL DEVICES === */
        @media(max-width: 1024px) {
            .section-padding { padding: 80px 5%; }
            .hero-content h1 { font-size: 3.5rem; }
            .about-container { flex-direction: column; text-align: center; }
            .portfolio-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
        }

        @media(max-width: 768px) {
            .section-header h2 { font-size: 2.3rem; }
            .hero-content h1 { font-size: 2.5rem; }
            .hero-content p { font-size: 1.1rem; }
            
            /* Enhanced Clean Mobile Navigation Menu */
            .nav-links {
                position: fixed;
                top: var(--header-height);
                left: 0;
                background-color: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(15px);
                width: 100%;
                height: calc(100vh - var(--header-height));
                flex-direction: column;
                align-items: center;
                justify-content: flex-start;
                padding-top: 40px;
                box-shadow: 0 15px 30px rgba(0,0,0,0.08);
                transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.3s ease;
                transform: translateY(-150%);
                opacity: 0;
                pointer-events: none;
            }
            
            .nav-links.active { 
                transform: translateY(0); 
                opacity: 1; 
                pointer-events: auto;
            }
            
            .nav-links li { margin: 15px 0; width: 100%; text-align: center; }
            .nav-links a { font-size: 16px; display: block; width: 100%; padding: 12px 0; }
            
            .menu-toggle { display: block; }
        }

        @media(max-width: 480px) {
            .hero-content h1 { font-size: 2rem; }
            .section-header h2 { font-size: 1.8rem; }
            .logo { font-size: 20px; }
            .btn { padding: 10px 25px; font-size: 12px; }
            .portfolio-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
